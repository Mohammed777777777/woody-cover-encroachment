    pct = 100 * c / class_stack.size
    print(f'  value {v}: {c:>10,} pixels ({pct:.2f}%)')

print(f'\nclass_stack shape: {class_stack.shape}')
print(f'class_stack dtype: {class_stack.dtype}')

