# -----------------------------------------------------------------------------
#  PART 1 -- Setup & load assets
# -----------------------------------------------------------------------------
import ee
import time
import numpy as np
import pandas as pd

ee.Authenticate()
ee.Initialize(project='osmgee')

sites     = ee.FeatureCollection('projects/annual-ccdc-new/assets/Elise_SampledPoints_Update')
SA        = ee.FeatureCollection('projects/annual-ccdc-new/assets/Elise_StudyArea_original')
LT_STACK  = ee.Image('projects/osmgee/assets/LT_fitted_ALL_stack')

LT_FEATURES = ['NDVI', 'B', 'G', 'R', 'NIR', 'SWIR1', 'SWIR2']

all_band_names = LT_STACK.bandNames().getInfo()
availableYears = sorted({
    int(b.split('_')[-1]) for b in all_band_names if b.startswith('LT_NDVI_')
})
print(f'Available years ({len(availableYears)}):', availableYears)

TRAIN_YEAR = 2023
assert TRAIN_YEAR in availableYears, f'{TRAIN_YEAR} not found in LT stack'



# -----------------------------------------------------------------------------
#  Rebuild LT_STACK as an ee.ImageCollection, one image per year
# -----------------------------------------------------------------------------

year_images = []
for year in availableYears:
    orig_bands = [f'LT_{f}_{year}' for f in LT_FEATURES]
    new_bands  = LT_FEATURES

    img = (LT_STACK
           .select(orig_bands, new_bands)
           .set('year', year)
           .set('system:time_start', ee.Date.fromYMD(year, 7, 1).millis()))
    year_images.append(img)

LT_COLLECTION = ee.ImageCollection.fromImages(year_images)

print('Collection size:', LT_COLLECTION.size().getInfo())
print('First image bands:', LT_COLLECTION.first().bandNames().getInfo())

# -----------------------------------------------------------------------------
#  Add extra spectral indices to LT_COLLECTION (computed from fitted bands)
# -----------------------------------------------------------------------------
def addExtraIndices(img):
    # WVI = Woody Vegetation Index
    wvi = img.expression(
        '((NIR - GREEN) / (NIR + GREEN)) - (SWIR1 / 2)',
        {'NIR': img.select('NIR'),
         'GREEN': img.select('G'),
         'SWIR1': img.select('SWIR1')}
    ).rename('WVI')

    # MSAVI2 = Modified Soil Adjusted Vegetation Index 2
    msavi2 = img.expression(
        '(2 * NIR + 1 - sqrt((2 * NIR + 1) ** 2 - 8 * (NIR - RED))) / 2',
        {'NIR': img.select('NIR'),
         'RED': img.select('R')}
    ).rename('MSAVI2')

    # NDI5 = Normalized Difference Index 5 (== NDMI)
    ndi5 = img.expression(
        '(NIR - SWIR1) / (NIR + SWIR1)',
        {'NIR': img.select('NIR'),
         'SWIR1': img.select('SWIR1')}
    ).rename('NDI5')

    # RBNDVI = Red Blue Normalized Different Vegetation Index
    rbndvi = img.expression(
        '(NIR - (RED + BLUE)) / (NIR + (RED + BLUE))',
        {'NIR': img.select('NIR'),
         'RED': img.select('R'),
         'BLUE': img.select('B')}
    ).rename('RBNDVI')

    return img.addBands([wvi, msavi2, ndi5, rbndvi])

LT_COLLECTION = LT_COLLECTION.map(addExtraIndices)

# Update the feature list used everywhere downstream
LT_FEATURES = LT_FEATURES + ['WVI', 'MSAVI2', 'NDI5', 'RBNDVI']

# Sanity check the updated collection
print('Updated first image bands:', LT_COLLECTION.first().bandNames().getInfo())
print('LT_FEATURES now includes:', LT_FEATURES)

# -----------------------------------------------------------------------------
#  Build a time-series GIF of LandTrendr-fitted NDVI
# -----------------------------------------------------------------------------
import requests
from IPython.display import Image, display

ndvi_col = LT_COLLECTION.select('NDVI').map(lambda img: img.clip(SA))

vis_params = {
    'min':          0.2,
    'max':          0.8,
    'palette':      ['ffffff', 'c7e9c0', '41ab5d', '005a32'],
    'region':       SA.geometry(),
    'dimensions':   600,
    'framesPerSecond': 3,
    'crs':          'EPSG:32613'
}

gif_url = ndvi_col.getVideoThumbURL(vis_params)
gif_path = '/content/ndvi_timeseries.gif'
r = requests.get(gif_url)
with open(gif_path, 'wb') as f:
    f.write(r.content)

display(Image(gif_path))

# ---- Add year labels to the frames ----
from PIL import Image as PILImage, ImageDraw, ImageFont

try:
    font = ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf', 32)
except OSError:
    font = ImageFont.load_default()

gif = PILImage.open(gif_path)
frames = []
try:
    while True:
        frame = gif.copy().convert('RGB')
        draw  = ImageDraw.Draw(frame)
        year  = availableYears[gif.tell()]
        label = str(year)
        x, y = 20, 20
        bbox = draw.textbbox((x, y), label, font=font)
        pad  = 6
        draw.rectangle([bbox[0]-pad, bbox[1]-pad, bbox[2]+pad, bbox[3]+pad], fill='white')
        draw.text((x, y), label, fill='black', font=font)
        frames.append(frame)
        gif.seek(gif.tell() + 1)
except EOFError:
    pass

out_gif = '/content/ndvi_timeseries_labeled.gif'
frames[0].save(out_gif, save_all=True, append_images=frames[1:], duration=333, loop=0)
display(Image(out_gif))


# -----------------------------------------------------------------------------
#  PART 2 -- Label field sites into 4 cover classes from Total_Wood
# -----------------------------------------------------------------------------
def assignClass(f):
    wc  = ee.Number(f.get('Total_Wood'))
    cls = ee.Number(ee.Algorithms.If(wc.eq(0),   0,
                    ee.Algorithms.If(wc.lte(15), 1,
                    ee.Algorithms.If(wc.lte(40), 2, 3))))
    return f.set('coverClass', cls)

sitesClassed = sites.map(assignClass)
print('Sites per cover class:',
      sitesClassed.reduceColumns(ee.Reducer.frequencyHistogram(), ['coverClass']).getInfo())


# -----------------------------------------------------------------------------
#  Sample ALL fitted bands at every site, every year -- all in memory
# -----------------------------------------------------------------------------
import pandas as pd
import matplotlib.pyplot as plt

def sample_year(img):
    year = img.get('year')
    sampled = img.sampleRegions(
        collection = sitesClassed,
        properties = ['coverClass'],
        scale      = 30,
        tileScale  = 8
    ).map(lambda f: f.set('year', year))
    return sampled

traj_fc = LT_COLLECTION.map(sample_year).flatten()

selectors = ['year', 'coverClass'] + LT_FEATURES

data = traj_fc.reduceColumns(
    reducer   = ee.Reducer.toList(len(selectors)),
    selectors = selectors
).get('list').getInfo()

traj_df = pd.DataFrame(data, columns=selectors)
print(f'Rows: {len(traj_df)}   (sites × years)')

# ---- Class-mean trajectories per band ----
class_colors = {0: '#8c510a', 1: '#c7e9c0', 2: '#41ab5d', 3: '#00441b'}
class_labels = {0: '0: none', 1: '1: ≤15%', 2: '2: ≤40%', 3: '3: >40%'}

fig, axes = plt.subplots(3, 3, figsize=(15, 10), sharex=True)
axes = axes.flat

for i, band in enumerate(LT_FEATURES):
    ax = axes[i]
    means = traj_df.groupby(['year', 'coverClass'])[band].mean().unstack('coverClass')
    for c in sorted(means.columns):
        ax.plot(means.index, means[c], marker='o', markersize=3, linewidth=1.5,
                color=class_colors[c], label=class_labels[c])
    ax.set_title(band)
    ax.grid(alpha=0.3)
    if i == 0:
        ax.legend(title='Cover class', fontsize=8, loc='best')

for j in range(len(LT_FEATURES), len(axes)):
    axes[j].axis('off')

fig.supxlabel('Year')
fig.supylabel('Mean LandTrendr-fitted value')
fig.suptitle('Fitted spectral trajectories by woody cover class, 1985–2025', fontsize=13)
plt.tight_layout()
plt.show()


# -----------------------------------------------------------------------------
#  Filter to 2023 only, stratified 70/30 train/test split
# -----------------------------------------------------------------------------

from sklearn.model_selection import train_test_split
from sklearn.utils.class_weight import compute_sample_weight

df_2023 = traj_df[traj_df['year'] == 2023].copy()
print(f'2023 rows: {len(df_2023)}')
print('\nClass distribution:')
print(df_2023['coverClass'].value_counts().sort_index())

# Drop any classes with fewer than 2 members
class_counts = df_2023['coverClass'].value_counts()
singletons   = class_counts[class_counts < 2].index.tolist()
if singletons:
    print(f'\nDropping single-member classes: {singletons}')
    df_2023 = df_2023[~df_2023['coverClass'].isin(singletons)]

X = df_2023[LT_FEATURES]
y = df_2023['coverClass'].astype(int)   # XGBoost wants integer labels

X_train, X_test, y_train, y_test = train_test_split(
    X, y,
    test_size    = 0.30,
    random_state = 42,
    stratify     = y
)

print(f'\nTrain: {X_train.shape}   Test: {X_test.shape}')

# XGBoost has no class_weight='balanced' — use sample weights instead
sample_weight_train = compute_sample_weight(class_weight='balanced', y=y_train)

# -----------------------------------------------------------------------------
#  PART 6 -- Hyperparameter tuning (XGBoost-specific grid, no refit)
# -----------------------------------------------------------------------------
import xgboost as xgb
from sklearn.model_selection import GridSearchCV, StratifiedKFold

param_grid = {
    'max_depth':        [3, 5, 7],       # tree depth (shallower than RF)
    'min_child_weight': [1, 3, 5],       # analogous to min_samples_leaf
    'subsample':        [0.7, 1.0],      # row subsampling per tree (like bagFraction)
    'colsample_bytree': [0.7, 1.0],      # feature subsampling per tree (like max_features)
}

cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)

xgb_base = xgb.XGBClassifier(
    objective       = 'multi:softprob',
    num_class       = 4,
    learning_rate   = 0.1,                # fixed for this stage
    n_estimators    = 300,                # fixed for this stage
    reg_lambda      = 1.0,                # default L2 regularization
    tree_method     = 'hist',             # fast histogram-based algorithm
    random_state    = 42,
    n_jobs          = -1,
    eval_metric     = 'mlogloss'
)

grid = GridSearchCV(
    estimator  = xgb_base,
    param_grid = param_grid,
    scoring    = 'f1_macro',
    cv         = cv,
    n_jobs     = -1,
    verbose    = 1,
    refit      = False
)

print('Running GridSearchCV on training split only...')
grid.fit(X_train, y_train, sample_weight=sample_weight_train)

best_params = grid.best_params_
print('\nBest structural hyperparameters:')
for k, v in best_params.items():
    print(f'  {k}: {v}')
print(f'\nBest CV f1_macro: {grid.best_score_:.4f}')


# -----------------------------------------------------------------------------
#  PART 6b -- Train the final XGBoost using best_params from Part 6
# -----------------------------------------------------------------------------
final_xgb = xgb.XGBClassifier(
    **best_params,
    objective       = 'multi:softprob',
    num_class       = 4,
    learning_rate   = 0.1,
    n_estimators    = 300,
    reg_lambda      = 1.0,
    tree_method     = 'hist',
    random_state    = 42,
    n_jobs          = -1,
    eval_metric     = 'mlogloss'
)

print('Fitting final XGBoost with tuned hyperparameters...')
final_xgb.fit(X_train, y_train, sample_weight=sample_weight_train)

print('Final model trained.')
print(f'  n_estimators: {final_xgb.n_estimators}')
print(f'  Hyperparameters used:')
for k, v in best_params.items():
    print(f'    {k}: {v}')

# -----------------------------------------------------------------------------
#  PART 7 -- Final model evaluation on the held-out test split
# -----------------------------------------------------------------------------
from sklearn.metrics import (accuracy_score, classification_report,
                             confusion_matrix, f1_score)
from sklearn.inspection import permutation_importance
import seaborn as sns

y_pred = final_xgb.predict(X_test)

print('\n=== Test-set evaluation (never seen during tuning) ===')
print('Accuracy:', round(accuracy_score(y_test, y_pred), 4))
print('F1 macro:', round(f1_score(y_test, y_pred, average='macro'), 4))
print('\nClassification report:')
print(classification_report(y_test, y_pred))

# Confusion matrix
cm = confusion_matrix(y_test, y_pred, labels=final_xgb.classes_)
plt.figure(figsize=(6, 5))
sns.heatmap(cm, annot=True, fmt='d', cmap='Purples',
            xticklabels=final_xgb.classes_, yticklabels=final_xgb.classes_)
plt.title('Confusion matrix — 2023 test split (XGBoost)')
plt.xlabel('Predicted'); plt.ylabel('True')
plt.tight_layout(); plt.show()

# ---- Built-in feature importance (impurity-based) ----
importances = pd.DataFrame({
    'feature':    X_train.columns,
    'importance': final_xgb.feature_importances_
}).sort_values('importance', ascending=False)
print('\nBuilt-in feature importances (impurity-based):')
print(importances.to_string(index=False))

plt.figure(figsize=(7, 4))
sns.barplot(x='importance', y='feature', data=importances, palette='mako')
plt.title('Built-in feature importance (final XGBoost)')
plt.tight_layout(); plt.show()

# ---- Permutation feature importance ----
# Model-agnostic, generalization-aware, comparable across all classifiers.
print('\nComputing permutation feature importance (may take ~30s)...')
perm = permutation_importance(
    final_xgb, X_test, y_test,
    n_repeats    = 20,
    random_state = 42,
    scoring      = 'f1_macro',
    n_jobs       = -1
)

importances_perm = pd.DataFrame({
    'feature':          X_train.columns,
    'importance_mean':  perm.importances_mean,
    'importance_std':   perm.importances_std
}).sort_values('importance_mean', ascending=False)

print('\nPermutation feature importances (drop in F1 macro when feature is shuffled):')
print(importances_perm.to_string(index=False))

plt.figure(figsize=(7, 4))
sns.barplot(x='importance_mean', y='feature', data=importances_perm, palette='rocket')
plt.title('Permutation feature importance (final XGBoost)')
plt.xlabel('Mean decrease in F1 macro')
plt.tight_layout(); plt.show()

# -----------------------------------------------------------------------------
#  PART 6b -- Refine learning_rate + n_estimators using early stopping
# -----------------------------------------------------------------------------
# With the winning structure params, drop learning_rate to 0.05 and let
# early stopping find the optimal number of trees on a validation split.
# -----------------------------------------------------------------------------
X_tr, X_val, y_tr, y_val = train_test_split(
    X_train, y_train,
    test_size    = 0.20,
    random_state = 42,
    stratify     = y_train
)
sw_tr = compute_sample_weight(class_weight='balanced', y=y_tr)

final_xgb = xgb.XGBClassifier(
    **best_params,
    objective              = 'multi:softprob',
    num_class              = 4,
    learning_rate          = 0.05,
    n_estimators           = 2000,        # upper bound; early stopping picks the real number
    reg_lambda             = 1.0,
    tree_method            = 'hist',
    random_state           = 42,
    n_jobs                 = -1,
    eval_metric            = 'mlogloss',
    early_stopping_rounds  = 50
)

print('\nFitting final XGBoost with tuned structure + early stopping...')
final_xgb.fit(
    X_tr, y_tr,
    sample_weight = sw_tr,
    eval_set      = [(X_val, y_val)],
    verbose       = False
)

print('Final model trained.')
print(f'  best_iteration: {final_xgb.best_iteration}')
print(f'  best_score:     {final_xgb.best_score:.4f}')

# -----------------------------------------------------------------------------
#  Apply trained XGBoost to every year in LT_COLLECTION (no Drive)
# -----------------------------------------------------------------------------
import rasterio
import tempfile
import os

year_list   = LT_COLLECTION.aggregate_array('year').getInfo()
n_years     = len(year_list)
class_stack = None
profile     = None

print(f'Predicting {n_years} years...')

for k, year in enumerate(year_list):
    img = ee.Image(LT_COLLECTION.filter(ee.Filter.eq('year', year)).first()).clip(SA)

    url = img.getDownloadURL({
        'scale':  30,
        'crs':    'EPSG:32613',
        'region': SA.geometry(),
        'format': 'GEO_TIFF'
    })

    with tempfile.NamedTemporaryFile(suffix='.tif', delete=False) as tmp:
        tmp_path = tmp.name
        r = requests.get(url, stream=True)
        for chunk in r.iter_content(chunk_size=1024*1024):
            tmp.write(chunk)

    with rasterio.open(tmp_path) as src:
        arr = src.read()

        if class_stack is None:
            H, W        = src.height, src.width
            profile     = src.profile.copy()
            class_stack = np.zeros((n_years, H, W), dtype=np.uint8)

        X_year = pd.DataFrame(
            arr.reshape(len(LT_FEATURES), -1).T,
            columns=LT_FEATURES
        )

        valid = np.isfinite(X_year.values).all(axis=1)

        preds = np.zeros(len(X_year), dtype=np.uint8)
        if valid.any():
            preds[valid] = final_xgb.predict(X_year[valid]).astype(np.uint8)

        class_stack[k] = preds.reshape(H, W)

    os.remove(tmp_path)
    print(f'  {year}  done')

# ---- Save locally ----
local_out = '/content/CoverClass_stack_LT_xgb.tif'

profile.update(
    count    = n_years,
    dtype    = 'uint8',
    compress = 'lzw'
)

with rasterio.open(local_out, 'w', **profile) as dst:
    dst.write(class_stack)
    for k, yr in enumerate(year_list):
        dst.set_band_description(k + 1, f'class_{yr}')

print(f'\nDone. Saved to: {local_out}')
print(f'class_stack shape: {class_stack.shape}')

# -----------------------------------------------------------------------------
#  Build a study-area mask matching class_stack
# -----------------------------------------------------------------------------
sa_mask_img = ee.Image.constant(1).clip(SA).unmask(0).byte()

url = sa_mask_img.getDownloadURL({
    'scale':  30,
    'crs':    'EPSG:32613',
    'region': SA.geometry(),
    'format': 'GEO_TIFF'
})

with tempfile.NamedTemporaryFile(suffix='.tif', delete=False) as tmp:
    tmp_path = tmp.name
    r = requests.get(url, stream=True)
    for chunk in r.iter_content(chunk_size=1024*1024):
        tmp.write(chunk)

with rasterio.open(tmp_path) as src:
    sa_mask = src.read(1).astype(bool)

os.remove(tmp_path)

print(f'SA mask shape: {sa_mask.shape}')
print(f'Pixels inside SA: {sa_mask.sum():,}  (~{sa_mask.sum() * 0.09:.0f} ha)')

assert sa_mask.shape == class_stack.shape[1:]

class_stack_masked = class_stack.copy()
class_stack_masked[:, ~sa_mask] = 255

print('\nClass counts after masking:')
for c in range(4):
    n = int((class_stack_masked == c).sum())
    print(f'  class {c}: {n:>10,} ({100*n/(class_stack_masked != 255).sum():.1f}%)')



# -----------------------------------------------------------------------------
#  Visualize classified maps for a few snapshot years
# -----------------------------------------------------------------------------
from matplotlib.colors import ListedColormap, BoundaryNorm

class_colors_map = ['#f2e8b0', '#c7e9c0', '#74c476', '#00441b']
cmap = ListedColormap(class_colors_map)
cmap.set_bad('white')
norm = BoundaryNorm([-0.5, 0.5, 1.5, 2.5, 3.5], cmap.N)

years_to_show = [1985, 1995, 2005, 2015, 2023, 2025]

fig, axes = plt.subplots(2, 3, figsize=(15, 9))
for ax, yr in zip(axes.flat, years_to_show):
    k = year_list.index(yr)
    disp = class_stack[k].astype(float)
    disp[~sa_mask] = np.nan
    ax.imshow(disp, cmap=cmap, norm=norm, interpolation='nearest')
    ax.set_title(f'{yr}', fontsize=13)
    ax.set_xticks([]); ax.set_yticks([])

fig.subplots_adjust(right=0.88)
cbar_ax = fig.add_axes([0.90, 0.25, 0.02, 0.5])
cbar = fig.colorbar(axes.flat[0].images[0], cax=cbar_ax, ticks=[0, 1, 2, 3])
cbar.ax.set_yticklabels(['0: none', '1: 0-15%', '2: 15-40%', '3: >40%'])
cbar.set_label('Woody cover class')

fig.suptitle('XGBoost-classified woody cover — Tongue Creek / OH Ranch', fontsize=15)
plt.savefig('/content/classified_maps_xgb.png', dpi=200, bbox_inches='tight')
plt.show()


# -----------------------------------------------------------------------------
#  Alluvial diagram (matplotlib) with area + percentage labels
# -----------------------------------------------------------------------------
from matplotlib.patches import Rectangle
from matplotlib.path import Path
import matplotlib.patches as mpatches

snapshot_years = [1985, 1990, 1995, 2000, 2005, 2010, 2015, 2020, 2025]
class_names    = ['0 (none)', '0-15', '15-40', '>40']
class_colors_a = ['#f2e8b0', '#c7e9c0', '#74c476', '#00441b']
n_classes      = 4
ha_per_pixel   = 0.09

snapshot_years = [y for y in snapshot_years if y in year_list]
maps = {yr: class_stack_masked[year_list.index(yr)] for yr in snapshot_years}

totals = np.zeros((len(snapshot_years), n_classes))
for i, yr in enumerate(snapshot_years):
    m = maps[yr]
    for c in range(n_classes):
        totals[i, c] = (m == c).sum() * ha_per_pixel

transitions = []
for i in range(len(snapshot_years) - 1):
    map_a, map_b = maps[snapshot_years[i]], maps[snapshot_years[i + 1]]
    T = np.zeros((n_classes, n_classes))
    for c_from in range(n_classes):
        for c_to in range(n_classes):
            T[c_from, c_to] = ((map_a == c_from) & (map_b == c_to)).sum() * ha_per_pixel
    transitions.append(T)

fig, ax = plt.subplots(figsize=(20, 12))
bar_width  = 0.50
year_gap   = 1.0
x_positions = np.arange(len(snapshot_years)) * year_gap

stack_order = [3, 2, 1, 0]
stratum_bounds = {}

for i, xc in enumerate(x_positions):
    y_cursor = 0.0
    for c in stack_order:
        h = totals[i, c]
        if h > 0:
            ax.add_patch(Rectangle(
                (xc - bar_width / 2, y_cursor),
                bar_width, h,
                facecolor=class_colors_a[c],
                edgecolor='black',
                linewidth=0.6,
                zorder=3
            ))
            pct = 100 * h / totals[i].sum()
            text_color = 'white' if c == 3 else 'black'
            ax.text(
                xc, y_cursor + h / 2,
                f'{class_names[c]}\n{h:.0f} ha\n{pct:.1f}%',
                ha='center', va='center', fontsize=10,
                color=text_color, zorder=4
            )
            stratum_bounds[(i, c)] = (y_cursor, y_cursor + h)
        else:
            stratum_bounds[(i, c)] = (y_cursor, y_cursor)
        y_cursor += h

for i, T in enumerate(transitions):
    x_a = x_positions[i]     + bar_width / 2
    x_b = x_positions[i + 1] - bar_width / 2

    src_cursor = {c: stratum_bounds[(i, c)][0] for c in range(n_classes)}
    tgt_cursor = {c: stratum_bounds[(i + 1, c)][0] for c in range(n_classes)}

    for c_from in stack_order[::-1]:
        for c_to in stack_order[::-1]:
            h = T[c_from, c_to]
            if h <= 0:
                continue

            y0_a = src_cursor[c_from]; y1_a = y0_a + h; src_cursor[c_from] = y1_a
            y0_b = tgt_cursor[c_to];   y1_b = y0_b + h; tgt_cursor[c_to]   = y1_b

            xm = (x_a + x_b) / 2
            verts = [
                (x_a, y0_a),
                (xm,  y0_a), (xm,  y0_b), (x_b, y0_b),
                (x_b, y1_b),
                (xm,  y1_b), (xm,  y1_a), (x_a, y1_a),
                (x_a, y0_a)
            ]
            codes = [Path.MOVETO,
                     Path.CURVE4, Path.CURVE4, Path.CURVE4,
                     Path.LINETO,
                     Path.CURVE4, Path.CURVE4, Path.CURVE4,
                     Path.CLOSEPOLY]
            path = Path(verts, codes)
            ax.add_patch(mpatches.PathPatch(
                path, facecolor=class_colors_a[c_from],
                edgecolor='none', alpha=0.4, zorder=2
            ))

ax.set_xticks(x_positions)
ax.set_xticklabels(snapshot_years, fontsize=11)
ax.set_ylabel('Area (hectares)', fontsize=12)
ax.set_xlabel('Year', fontsize=12)
ax.set_title(f'Woody cover class transitions (XGBoost), '
             f'{snapshot_years[0]}–{snapshot_years[-1]}', fontsize=14)
ax.set_ylim(0, totals.sum(axis=1).max() * 1.02)
ax.set_xlim(x_positions[0] - 0.5, x_positions[-1] + 0.5)
ax.grid(axis='y', alpha=0.2, zorder=1)
ax.set_axisbelow(True)

legend_patches = [mpatches.Patch(facecolor=class_colors_a[c],
                                 edgecolor='black',
                                 label=class_names[c])
                  for c in range(n_classes)]
ax.legend(handles=legend_patches, loc='lower center',
          bbox_to_anchor=(0.5, -0.15), ncol=n_classes,
          frameon=False, title='Woody cover class')

plt.subplots_adjust(bottom=0.15)
plt.tight_layout()

plt.savefig('/content/alluvial_woody_cover_xgb.png', dpi=300, bbox_inches='tight')
plt.show()
