# -----------------------------------------------------------------------------
#  Alluvial diagram with area + percentage labels
# -----------------------------------------------------------------------------
from matplotlib.patches import Rectangle
from matplotlib.path import Path
import matplotlib.patches as mpatches

snapshot_years = [1985, 1990, 1995, 2000, 2005, 2010, 2015, 2020, 2025]
class_names    = ['0 (none)', '0-15', '15-40', '>40']
class_colors_a = ['#f2e8b0', '#c7e9c0', '#74c476', '#00441b']
n_classes      = 4
ha_per_pixel   = 0.09

snapshot_years = [y for y in snapshot_years if y in year_list]
maps = {yr: class_stack_masked[year_list.index(yr)] for yr in snapshot_years}

totals = np.zeros((len(snapshot_years), n_classes))
for i, yr in enumerate(snapshot_years):
    m = maps[yr]
    for c in range(n_classes):
        totals[i, c] = (m == c).sum() * ha_per_pixel

transitions = []
for i in range(len(snapshot_years) - 1):
    map_a, map_b = maps[snapshot_years[i]], maps[snapshot_years[i + 1]]
    T = np.zeros((n_classes, n_classes))
    for c_from in range(n_classes):
        for c_to in range(n_classes):
            T[c_from, c_to] = ((map_a == c_from) & (map_b == c_to)).sum() * ha_per_pixel
    transitions.append(T)

fig, ax = plt.subplots(figsize=(20, 12))
bar_width  = 0.50
year_gap   = 1.0
x_positions = np.arange(len(snapshot_years)) * year_gap

stack_order = [3, 2, 1, 0]
stratum_bounds = {}

for i, xc in enumerate(x_positions):
    y_cursor = 0.0
    for c in stack_order:
        h = totals[i, c]
        if h > 0:
            ax.add_patch(Rectangle(
                (xc - bar_width / 2, y_cursor),
                bar_width, h,
                facecolor=class_colors_a[c],
                edgecolor='black',
                linewidth=0.6,
                zorder=3
            ))
            pct = 100 * h / totals[i].sum()
            text_color = 'white' if c == 3 else 'black'
            ax.text(
                xc, y_cursor + h / 2,
                f'{class_names[c]}\n{h:.0f} ha\n{pct:.1f}%',
                ha='center', va='center', fontsize=16,
                color=text_color, zorder=4
            )
            stratum_bounds[(i, c)] = (y_cursor, y_cursor + h)
        else:
            stratum_bounds[(i, c)] = (y_cursor, y_cursor)
        y_cursor += h

for i, T in enumerate(transitions):
    x_a = x_positions[i]     + bar_width / 2
    x_b = x_positions[i + 1] - bar_width / 2

    src_cursor = {c: stratum_bounds[(i, c)][0] for c in range(n_classes)}
    tgt_cursor = {c: stratum_bounds[(i + 1, c)][0] for c in range(n_classes)}

    for c_from in stack_order[::-1]:
        for c_to in stack_order[::-1]:
            h = T[c_from, c_to]
            if h <= 0:
                continue

            y0_a = src_cursor[c_from]; y1_a = y0_a + h; src_cursor[c_from] = y1_a
            y0_b = tgt_cursor[c_to];   y1_b = y0_b + h; tgt_cursor[c_to]   = y1_b

            xm = (x_a + x_b) / 2
            verts = [
                (x_a, y0_a),
                (xm,  y0_a), (xm,  y0_b), (x_b, y0_b),
                (x_b, y1_b),
                (xm,  y1_b), (xm,  y1_a), (x_a, y1_a),
                (x_a, y0_a)
            ]
            codes = [Path.MOVETO,
                     Path.CURVE4, Path.CURVE4, Path.CURVE4,
                     Path.LINETO,
                     Path.CURVE4, Path.CURVE4, Path.CURVE4,
                     Path.CLOSEPOLY]
            path = Path(verts, codes)
            ax.add_patch(mpatches.PathPatch(
                path, facecolor=class_colors_a[c_from],
                edgecolor='none', alpha=0.4, zorder=2
            ))

ax.set_xticks(x_positions)
ax.set_xticklabels(snapshot_years, fontsize=14)
ax.set_ylabel('Area (hectares)', fontsize=14)
ax.set_xlabel('Year', fontsize=14)
ax.set_title(f'Woody cover class transitions (SVM), '
             f'{snapshot_years[0]}–{snapshot_years[-1]}', fontsize=14)
ax.set_ylim(0, totals.sum(axis=1).max() * 1.02)
ax.set_xlim(x_positions[0] - 0.5, x_positions[-1] + 0.5)
ax.grid(axis='y', alpha=0.2, zorder=1)
ax.set_axisbelow(True)
ax.tick_params(axis='y', labelsize=14)

legend_patches = [mpatches.Patch(facecolor=class_colors_a[c],
                                 edgecolor='black',
                                 label=class_names[c])
                  for c in range(n_classes)]
ax.legend(handles=legend_patches, loc='lower center',
          bbox_to_anchor=(0.5, -0.12), ncol=n_classes,
          frameon=False, title='Woody cover class',
          fontsize=15, title_fontsize=15)

plt.subplots_adjust(bottom=0.15)
plt.tight_layout()

plt.savefig('/content/alluvial_woody_cover_svm.png', dpi=300, bbox_inches='tight')
plt.show()
