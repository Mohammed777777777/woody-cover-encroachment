# -----------------------------------------------------------------------------
#  Transition maps between consecutive snapshot years
# -----------------------------------------------------------------------------
from matplotlib.colors import ListedColormap, BoundaryNorm
import matplotlib.patches as mpatches

snapshot_years = [1985, 1990, 1995, 2000, 2005, 2010, 2015, 2020, 2025]
snapshot_years = [y for y in snapshot_years if y in year_list]

pairs = list(zip(snapshot_years[:-1], snapshot_years[1:]))
print(f'Number of transition pairs: {len(pairs)}')

rows_with_data = np.where(sa_mask.any(axis=1))[0]
cols_with_data = np.where(sa_mask.any(axis=0))[0]
r0, r1 = rows_with_data.min(), rows_with_data.max()
c0, c1 = cols_with_data.min(), cols_with_data.max()

def build_transition_map(map_a, map_b):
    trans = np.full_like(map_a, 255, dtype=np.uint8)
    valid = sa_mask
    trans[valid] = map_a[valid].astype(np.uint8) * 10 + map_b[valid].astype(np.uint8)
    return trans

# ---- Color scheme ----
# All same-class (diagonal) share the same gray
# Each gain gets its own unique green (progressively darker)
# Each loss gets its own unique red (progressively darker)
transition_colors = {
    # Same class -> gray (single color, single legend entry)
    0:  '#bdbdbd',
    11: '#bdbdbd',
    22: '#bdbdbd',
    33: '#bdbdbd',
    # Gains -> unique greens, ordered light to dark by magnitude of gain
    1:  '#e5f5e0',   # 0->1  adjacent (smallest gain)
    12: '#c7e9c0',   # 1->2  adjacent
    23: '#a1d99b',   # 2->3  adjacent
    2:  '#74c476',   # 0->2  skip-one
    13: '#41ab5d',   # 1->3  skip-one
    3:  '#00441b',   # 0->3  large jump (biggest gain)
    # Losses -> unique reds, ordered light to dark by magnitude of loss
    32: '#fee5d9',   # 3->2  adjacent (smallest loss)
    21: '#fcbba1',   # 2->1  adjacent
    10: '#fc9272',   # 1->0  adjacent
    31: '#fb6a4a',   # 3->1  skip-one
    20: '#ef3b2c',   # 2->0  skip-one
    30: '#67000d',   # 3->0  large jump (biggest loss)
}

transition_labels = {
    0:  'No change (0 → 0, 1 → 1, 2 → 2, 3 → 3)',
    1:  '0 → 1 (gain)',
    12: '1 → 2 (gain)',
    23: '2 → 3 (gain)',
    2:  '0 → 2 (gain)',
    13: '1 → 3 (gain)',
    3:  '0 → 3 (gain)',
    32: '3 → 2 (loss)',
    21: '2 → 1 (loss)',
    10: '1 → 0 (loss)',
    31: '3 → 1 (loss)',
    20: '2 → 0 (loss)',
    30: '3 → 0 (loss)',
}

codes = sorted(transition_colors.keys())
colors_list = [transition_colors[c] for c in codes]
cmap_trans = ListedColormap(colors_list)
cmap_trans.set_bad('white')

bounds = [c - 0.5 for c in codes] + [codes[-1] + 0.5]
norm_trans = BoundaryNorm(bounds, cmap_trans.N)

# ---- Layout: 2 rows x 4 cols ----
fig, axes = plt.subplots(2, 4, figsize=(24, 10),
                          gridspec_kw={'hspace': 0.02, 'wspace': 0.05})

for ax, (yr_a, yr_b) in zip(axes.flat, pairs):
    k_a = year_list.index(yr_a)
    k_b = year_list.index(yr_b)
    map_a = class_stack[k_a]
    map_b = class_stack[k_b]
    trans_map = build_transition_map(map_a, map_b)

    disp = trans_map[r0:r1+1, c0:c1+1].astype(float)
    disp[disp == 255] = np.nan

    ax.imshow(disp, cmap=cmap_trans, norm=norm_trans, interpolation='nearest', aspect='equal')
    ax.set_title(f'{yr_a} → {yr_b}', fontsize=18)
    ax.set_xticks([]); ax.set_yticks([])

for i in range(len(pairs), 8):
    axes.flat[i].axis('off')

# ---- Legend: one gray + 6 greens + 6 reds = 13 entries ----
legend_patches = [
    mpatches.Patch(facecolor='#bdbdbd', edgecolor='black',
                    label='No change (0→0, 1→1, 2→2, 3→3)'),
    # Gains (ordered light to dark)
    mpatches.Patch(facecolor='#e5f5e0', edgecolor='black', label='0 → 1 (gain)'),
    mpatches.Patch(facecolor='#c7e9c0', edgecolor='black', label='1 → 2 (gain)'),
    mpatches.Patch(facecolor='#a1d99b', edgecolor='black', label='2 → 3 (gain)'),
    mpatches.Patch(facecolor='#74c476', edgecolor='black', label='0 → 2 (gain)'),
    mpatches.Patch(facecolor='#41ab5d', edgecolor='black', label='1 → 3 (gain)'),
    mpatches.Patch(facecolor='#00441b', edgecolor='black', label='0 → 3 (gain)'),
    # Losses (ordered light to dark)
    mpatches.Patch(facecolor='#fee5d9', edgecolor='black', label='3 → 2 (loss)'),
    mpatches.Patch(facecolor='#fcbba1', edgecolor='black', label='2 → 1 (loss)'),
    mpatches.Patch(facecolor='#fc9272', edgecolor='black', label='1 → 0 (loss)'),
    mpatches.Patch(facecolor='#fb6a4a', edgecolor='black', label='3 → 1 (loss)'),
    mpatches.Patch(facecolor='#ef3b2c', edgecolor='black', label='2 → 0 (loss)'),
    mpatches.Patch(facecolor='#67000d', edgecolor='black', label='3 → 0 (loss)'),
]

fig.legend(handles=legend_patches, loc='lower center',
           bbox_to_anchor=(0.5, -0.05), ncol=7, frameon=False,
